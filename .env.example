# --- Required (prefer these as Cloud Agent secrets too) ---
# League ID: from your Sleeper league URL → sleeper.com/leagues/<LEAGUE_ID>/…
SLEEPER_LEAGUE_ID=
# Roster ID: stable numeric ID for your team in that league (preferred).
SLEEPER_ROSTER_ID=

# Optional fallback if you don't know your roster ID yet:
# SLEEPER_USERNAME=

# --- Optional ---
# Free tier at https://the-odds-api.com/ (500 req/mo). Without this, the
# "game script" (spread/total) signal is skipped and everything else still works.
ODDS_API_KEY=

# FantasyPros API key (https://secure.fantasypros.com/api-keys/request).
# Adds a second weekly projection source; mean of RotoWire + FantasyPros is used.
FANTASYPROS_API_KEY=

# Override the week the advisor analyzes. Defaults to Sleeper's current NFL week.
SLEEPER_WEEK=
