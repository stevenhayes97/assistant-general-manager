# --- Required (prefer these as Cloud Agent secrets too) ---
# League ID: from your Sleeper league URL → sleeper.com/leagues/<LEAGUE_ID>/…
SLEEPER_LEAGUE_ID=
# Roster ID: stable numeric ID for your team in that league (preferred).
SLEEPER_ROSTER_ID=

# Optional fallback if you don't know your roster ID yet:
# SLEEPER_USERNAME=

# --- Optional ---
# Vegas spread/total/implied totals + game-script flags (primary lines source).
# Free tier at https://the-odds-api.com/ (500 req/mo).
ODDS_API_KEY=

# FantasyPros API key (https://secure.fantasypros.com/api-keys/request).
# OPTIONAL weekly *fantasy point* projections (`/nfl/{season}/projections?week=N`
# only). Empty/zero rows are excluded from blended means. Omit if unused.
FANTASYPROS_API_KEY=

# Tank01 RapidAPI key (https://rapidapi.com/tank01/api/tank01-nfl-live-in-game-real-time-statistics-nfl).
# Weekly projections + multi-book betting odds (second opinion vs Odds API) + depth charts.
TANK01_API_KEY=

# Override the week the advisor analyzes. Defaults to Sleeper's current NFL week.
SLEEPER_WEEK=
