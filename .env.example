# --- Required for the POC (hardcode-able for now, becomes user input in the API later) ---
SLEEPER_LEAGUE_ID=
SLEEPER_ROSTER_ID=
# Alternative to SLEEPER_ROSTER_ID: resolve your roster by Sleeper username instead.
SLEEPER_USERNAME=

# --- Optional ---
# Free tier at https://the-odds-api.com/ (500 req/mo). Without this, the
# "game script" (spread/total) signal is skipped and everything else still works.
ODDS_API_KEY=

# Override the week the advisor analyzes. Defaults to Sleeper's current NFL week.
SLEEPER_WEEK=
